/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), geolocation=(self), microphone=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; img-src 'self' blob: data:; connect-src 'self' https://dept-modern-intervention-recorders.trycloudflare.com; style-src 'self' 'unsafe-inline'; script-src 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
